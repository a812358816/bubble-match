[remap]
importer="font_data"
type="FontFile"
uid="uid://emoji_fallback_font"
path="res://.godot/imported/emoji.ttf-<hash>.fontdata"

[deps]
source_file="res://assets/fonts/emoji.ttf"

[params]
compress=true
preload/char_ranges=PackedStringArray()
preload/glyph_ranges=PackedStringArray()
antialiased=true
disable_embedded_bitmaps=false
force_autohinter=false
hinting=1
subpixel_positioning=1
multichannel_signed_distance_field=false
msdf_pixel_range=8
msdf_size=48
oversampling=0.0
allow_system_fallback=true
